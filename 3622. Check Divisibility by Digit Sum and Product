class Solution {
    public boolean checkDivisibility(int n) {
        int og = n;
        int sum = 0;
        int product = 1;
        while(og != 0){
            int digit = og % 10;
            sum+=digit;
            product*=digit;
            og /= 10;
        }
        return n % (sum + product) == 0;
    }
}
